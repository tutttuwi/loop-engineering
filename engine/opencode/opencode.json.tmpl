{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "{{LMSTUDIO_BASE_URL}}"
      },
      "models": {
        "{{LMSTUDIO_MODEL_ID}}": {
          "name": "{{LMSTUDIO_MODEL_NAME}}"
        }
      }
    }
  },
  "model": "lmstudio/{{LMSTUDIO_MODEL_ID}}"
}
