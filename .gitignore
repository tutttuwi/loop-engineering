# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Node / Bun
node_modules/
bun.lockb
npm-debug.log*

# Python (report/video helper scripts)
__pycache__/
*.pyc
.venv/

# Secrets / local config
.env
.env.*
!*.env.example
project-config/target.yaml
project-config/targets/*.yaml
!project-config/targets/README.md
project-config/**/*.local.*

# Ralph / OpenCode runtime state (created inside target projects, but ignore if present here)
.ralph/
.opencode/local/

# Loop execution outputs
# 実成果物は対象プロジェクトの <target>/.loop-engineering/output/ に置く。
# 基盤リポジトリ直下の output/ は互換用の空置き場。
output/**
!output/.gitkeep
!output/README.md

# Misc
*.log
*.tmp
