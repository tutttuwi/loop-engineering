# project-config/target.yaml
#
# ループを実行する「対象プロジェクト」を指定する設定ファイル。
# このファイル自体は .gitignore 対象(環境依存のローカルパスを含むため)。
# 他プロジェクトへ本基盤を移植する際は、このファイルだけ書き換えれば良い設計になっている。
#
# 使い方: このファイルを project-config/target.yaml としてコピーし、値を編集する
#   cp project-config/target.yaml.example project-config/target.yaml
#
# 複数プロジェクトを切り替える場合:
#   mkdir -p project-config/targets
#   cp project-config/target.yaml.example project-config/targets/app-a.yaml
#   ./engine/run-loop.sh --loop yabaiyo --target-name app-a
#
# 制約: このツールキットの設定ファイルは「ネストなし・リストなしのフラットな key: value」のみ
#       サポートする(engine/lib/common.sh の簡易YAMLリーダーの制約)。

# 対象プロジェクトのローカル絶対パス(または相対パス)
target_path: /path/to/your/target-project

# レポートや通知に表示する対象プロジェクトの名前
target_name: your-project-name

# Issue投稿先の種別: github | gitlab | both
repo_provider: github

# Issue投稿先リポジトリのURL (例: https://github.com/your-org/your-repo)
repo_url: https://github.com/your-org/your-repo

# 対象プロジェクトの既定ブランチ
default_branch: main

# Ralph に渡す実行エージェント (省略時は loop.yaml の agent、さらに無ければ opencode)
#   opencode       OpenCode + ローカルLLM (LM Studio 等)
#   claude-code    Anthropic Claude Code CLI (`claude`)
#   cursor-agent   Cursor Agent CLI (`agent` / `cursor-agent`)
# エイリアス: claude, cursor, local
# CLI が最優先: ./engine/run-loop.sh --agent cursor-agent
agent: opencode

# init が対象PJへ書くレイアウト (省略時は上の agent のみ)
#   all または opencode,claude-code,cursor-agent
# init_agents: all

# モンキーテストループで操作する対象URL(フロントエンド/モバイルアプリのプレビューURL等)
monkey_test_target_url: http://localhost:3000

# モンキーテストで使うテスト用アカウント（任意）。本番アカウントは書かない。
# 形式: カンマ区切り。各エントリは role または role|login|secret
# 値にカンマ・パイプ・# を含めないこと（フラットYAML制約）。
# 空ならエージェントが docs / E2E fixtures / seed から探索する。
# 例: guest,member|user@example.com|test-pass,admin|admin@example.com|test-pass
monkey_test_accounts:

# PR/MRレビューループで対象にするPR/MRの番号またはURL
pr_review_target: https://github.com/your-org/your-repo/pull/123

# ---------------------------------------------------------------------------
# Issue投稿モード(レビュー結果・報告のチケット起票先)
#   create ... ループ実行ごとに新規Issueを作成する(既定。チケット番号を新規払い出し)
#   update ... 既存Issueへコメント追記する(issue_target 必須)
# ---------------------------------------------------------------------------
issue_post_mode: create

# issue_post_mode=update のとき使う既存Issueの番号またはURL
# 例: 42  /  https://github.com/your-org/your-repo/issues/42
# create のときは空でよい
issue_target:

# OpenCode MCP permission: ask(対話確認・既定) | allow(無人ループ) | deny
# init 時の --mcp-permission / LOOP_MCP_PERMISSION が優先
mcp_permission: ask

# サーバ別上書き (任意)。OpenCode の permission.<server>_* に展開される。
# 例: 一括は ask のまま、Issue 用 github だけ allow / ブラウザ操作は deny
# mcp_permission_overrides: github=allow,playwright=deny
# CLI: --mcp-permission-overrides / 環境変数: LOOP_MCP_PERMISSION_OVERRIDES
# 限界: サーバ内の個別ツール名までの DSL は未対応（OpenCode 側のサーバ単位 glob）
mcp_permission_overrides: